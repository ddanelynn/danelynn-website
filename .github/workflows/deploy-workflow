name: Deploy Angular to GitHub Pages

on:
  push:
    branches:
      - main # Triggers the build every time you push code to main

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18 # Matches standard Angular 13+ environments

      - name: Install dependencies
        run: npm ci

      - name: Build Application
        run: npx ng build --configuration production --base-href /danelynn-website/

      - name: Deploy to GitHub Pages
        uses: JamesIves/github-pages-deploy-action@v4
        with:
          folder: dist/danelynn-website # Deploys the built folder
          branch: gh-pages # Automatically creates this branch for you
